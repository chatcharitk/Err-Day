generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id                String             @id @default(cuid())
  name              String
  address           String
  phone             String
  imageUrl          String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  mapLat            Float?
  mapLng            Float?
  mapUrl            String?
  closeTime         String?
  openTime          String?
  bookingEnabled    Boolean            @default(true)
  /// *
  ///    * Concurrency cap for ONLINE (LIFF/customer-facing) bookings.
  ///    *   null → no cap (use staff-on-shift count)
  ///    *   0    → online booking effectively disabled
  ///    *   N    → cap online bookings at N overlapping appointments
  ///    * Admin/POS bookings bypass this entirely.
  ///    * Use to reserve some chairs for walk-ins on busy branches.
  onlineCap         Int?
  /// Revenue-Department branch code printed on receipts: "00000" = สำนักงานใหญ่,
  /// "00001" = สาขาที่ 1, etc. Null until the company fills it in under settings.
  taxBranchCode     String?
  blockedSlots      BlockedSlot[]
  bookings          Booking[]
  services          BranchService[]
  capacityOverrides CapacityOverride[]
  expenses          Expense[]
  receipts          Receipt[]
  staff             Staff[]
}

/// *
///  * Per-time-window override of the branch's default online cap.
///  * Either `date` (specific calendar day) or `dayOfWeek` (recurring weekly) is set.
///  * For a given query time the most specific match wins:
///  *     date-specific > day-of-week > branch.onlineCap > staff count
model CapacityOverride {
  id        String    @id @default(cuid())
  branchId  String
  /// * Specific date this override applies to (mutually exclusive with dayOfWeek).
  date      DateTime?
  /// * Recurring weekly: 0 = Sunday … 6 = Saturday (mutually exclusive with date).
  dayOfWeek Int?
  startTime String
  endTime   String
  capacity  Int
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, date])
  @@index([branchId, dayOfWeek])
}

model Service {
  id                     String          @id @default(cuid())
  name                   String
  description            String?
  imageUrl               String?
  category               String
  isActive               Boolean         @default(true)
  /// false = internal-only: staff can book / ring it up (calendar, POS, mobile
  /// new-booking) but customers never see or book it online. Toggle in
  /// admin → services. Existing services default to public.
  isPublic               Boolean         @default(true)
  advanceBookingRequired Boolean         @default(false)
  availableFrom          String?
  availableTo            String?
  /// Last Bangkok day ("YYYY-MM-DD", inclusive) this service is offered, by
  /// APPOINTMENT date (time-limited menu items). null = no end date. Distinct
  /// from availableFrom/To above, which hold time-of-day windows ("11:00").
  endsOn                 String?
  descriptionTh          String?
  memberPrice            Int?
  nameTh                 String          @default("")
  memberDiscountPercent  Int             @default(0)
  /// Fixed commission (ค่ามือ) in satang the performing stylist earns each time
  /// this service is completed — independent of what the customer paid (member
  /// discount / package redemption don't reduce it). 0 = no commission.
  commissionSatang       Int             @default(0)
  /// "ค่าเชียร์" — paid to the staff member who talked the customer into this
  /// service (e.g. a treatment), recorded at POS checkout. 0 = none.
  cheerSatang            Int             @default(0)
  bookings               Booking[]
  cheers                 BookingCheer[]
  branches               BranchService[]
}

model BranchService {
  id        String  @id @default(cuid())
  branchId  String
  serviceId String
  price     Int
  duration  Int
  isActive  Boolean @default(true)
  branch    Branch  @relation(fields: [branchId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([branchId, serviceId])
}

model Staff {
  id             String         @id @default(cuid())
  branchId       String
  name           String
  avatarUrl      String?
  isActive       Boolean        @default(true)
  commissionRate Float          @default(0)
  phone          String?
  passcodeHash   String?
  /// The same PIN, encrypted (AES-256-GCM, key from STAFF_SESSION_SECRET) so
  /// admins can look it up for a staff member. Login still checks the hash.
  passcodeEnc    String?
  lastLoginAt    DateTime?
  /// ── Payroll config ──────────────────────────────────────────────────────
  /// How base pay is defined. MONTHLY_SALARY → baseSatang is a monthly salary;
  /// DAILY_WAGE → baseSatang is paid per day worked.
  payType        StaffPayType   @default(MONTHLY_SALARY)
  /// Base pay in satang (monthly salary OR daily wage, per payType). 0 = unset.
  baseSatang     Int            @default(0)
  /// How the base is disbursed (reporting/rollup only; doesn't affect daily OT/commission).
  payCadence     PayCadence     @default(MONTHLY)
  /// Optional manual OT hourly-rate override in satang. null → derive from base
  /// (MONTHLY: baseSatang/240 i.e. /(30*8); DAILY: baseSatang/8).
  otRateSatang   Int?
  normalWorkMinutes Int         @default(540)
  attendance     StaffAttendance[]
  payee          Vendor?
  blockedSlots   BlockedSlot[]
  bookings       Booking[]
  bookingStaff   BookingStaff[]
  cheers         BookingCheer[]
  branch         Branch         @relation(fields: [branchId], references: [id])
  shifts         StaffShift[]
  dailyPayouts   StaffDailyPayout[]
}

/// One row per staff per day — the daily cash-out the owner pays (commission +
/// OT). Commission is computed live from that day's completed bookings; this row
/// stores the admin-entered OT hours, a `worked` flag (for daily-wage base
/// accrual), and a snapshot + paid status once settled.
model StaffDailyPayout {
  id               String       @id @default(cuid())
  staffId          String
  branchId         String
  /// UTC-noon of the Bangkok calendar day (same convention as Booking.date).
  date             DateTime
  /// Admin-entered overtime hours for the day (e.g. 1.5).
  otHours          Float        @default(0)
  otMode           String       @default("MANUAL")
  adjustmentSatang Int          @default(0)
  adjustmentReason String?
  calculation      Json?
  revision         Int          @default(0)
  /// Admin-entered tip amount for the day (satang) — a flat entry, not hours × rate.
  tipSatang        Int          @default(0)
  /// Whether the staff worked this day — drives daily-wage base accrual.
  worked           Boolean      @default(true)
  status           PayoutStatus @default(PENDING)
  /// Snapshots taken when marked PAID (satang). Null while pending → compute live.
  commissionSatang Int?
  otSatang         Int?
  /// Tips entered on the day's bookings, snapshotted when marked PAID (null while pending).
  bookingTipSatang Int?
  /// Travel allowance (ค่าเดินทาง) for the day, satang — entered on the payroll review.
  travelSatang     Int          @default(0)
  paidAt           DateTime?
  paidBy           String?
  /// Set once this day's payout has been recorded as an Expense (review/edit step in the UI).
  expenseId        String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  staff            Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([branchId, date])
  @@index([status, date])
}

model StaffAttendance {
  id String @id @default(cuid())
  staffId String
  date DateTime
  clockIn DateTime
  clockOut DateTime
  breakMinutes Int @default(0)
  confirmedBy String
  notes String?
  updatedAt DateTime @updatedAt
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  @@unique([staffId, date])
  @@index([date])
}

model FinanceAudit {
  id String @id @default(cuid())
  entity String
  recordId String
  action String
  actor String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([entity, recordId, createdAt])
}

model StaffShift {
  id        String   @id @default(cuid())
  staffId   String
  date      DateTime
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date, startTime])
  @@index([date])
  @@index([staffId, date])
}

/// *
///  * Admin-created time blocks — prevent customer bookings and show as "closed"
///  * on the calendar. staffId = null means the whole branch is blocked; a specific
///  * staffId blocks just that staff member.
model BlockedSlot {
  id        String   @id @default(cuid())
  branchId  String
  staffId   String?
  date      String
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff     Staff?   @relation(fields: [staffId], references: [id])

  @@index([branchId, date])
  @@index([staffId, date])
}

model Customer {
  id               String            @id @default(cuid())
  name             String
  phone            String            @unique
  email            String?
  lineUserId       String?           @unique
  createdAt        DateTime          @default(now())
  gender           String?
  pictureUrl       String?
  pdpaConsentAt    DateTime?
  pdpaSource       String?
  pdpaVersion      String?
  nickname         String?
  notes            String?
  photoUrls        String?
  dateOfBirth      DateTime?
  lineDisplayName  String?
  /// Set when the name/nickname were checked in the Oct 2026 cleanup (drops it off the checklist).
  nameCheckedAt    DateTime?
  hairProfile      HairProfile?
  colorVisits      ColorVisit[]
  bookings         Booking[]
  packages         CustomerPackage[]
  membership       Membership?
  inboxThreads     InboxThread[]
  membershipCycles MembershipCycle[]
  staffVotes       StaffVote[]
  coupons          Coupon[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "Customer_name_trgm_idx", type: Gin)
  @@index([nickname(ops: raw("gin_trgm_ops"))], map: "Customer_nickname_trgm_idx", type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], map: "Customer_phone_trgm_idx", type: Gin)
}

model TarotUsage {
  id         String   @id @default(cuid())
  lineUserId String
  usageDate  String
  count      Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([lineUserId, usageDate])
  @@index([updatedAt])
}

model MembershipTier {
  id              String       @id @default(cuid())
  name            String
  nameTh          String
  minPoints       Int
  discountPercent Int          @default(0)
  color           String       @default("#6b7280")
  isActive        Boolean      @default(true)
  maxUsages       Int          @default(0)
  validityDays    Int          @default(30)
  memberships     Membership[]
}

model Membership {
  id                String            @id @default(cuid())
  customerId        String            @unique
  tierId            String?
  points            Int               @default(0)
  joinedAt          DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  activatedAt       DateTime          @default(now())
  expiresAt         DateTime?
  usagesAllowed     Int               @default(0)
  usagesUsed        Int               @default(0)
  label             String            @default("สมาชิก")
  /// true until payment/activation is confirmed by POS or an admin. Defaulting
  /// to pending prevents a bare Membership insert from granting benefits.
  pendingActivation Boolean           @default(true)
  /// Membership terms the customer accepted when applying. null on rows created
  /// at the counter, where the terms are agreed in person.
  termsAcceptedAt   DateTime?
  termsVersion      String?
  customer          Customer          @relation(fields: [customerId], references: [id])
  tier              MembershipTier?   @relation(fields: [tierId], references: [id])
  cycles            MembershipCycle[]
}

/// One row per membership "cycle" (each 30-day period the customer pays for).
/// Created when staff sells the membership SKU in POS, or when admin uses
/// the manual renew button. Lets us keep history across renewals.
model MembershipCycle {
  id            String     @id @default(cuid())
  customerId    String
  membershipId  String
  startedAt     DateTime   @default(now())
  endedAt       DateTime
  closedAt      DateTime?
  paidAmount    Int        @default(0)
  paymentMethod String?
  bookingsUsed  Int        @default(0)
  bookingId     String?
  notes         String?
  customer      Customer   @relation(fields: [customerId], references: [id])
  membership    Membership @relation(fields: [membershipId], references: [id])

  @@index([customerId, startedAt])
  @@index([membershipId])
}

/// One row per package purchase (Buffet 30d / 5-pack 90d).
/// Each customer can hold multiple active packages; redemption decrements usagesUsed.
model CustomerPackage {
  id                String    @id @default(cuid())
  customerId        String
  packageSku        String
  startedAt         DateTime  @default(now())
  expiresAt         DateTime
  usagesUsed        Int       @default(0)
  usageLimit        Int
  paidAmount        Int       @default(0)
  paymentMethod     String?
  bookingId         String?
  closedAt          DateTime?
  notes             String?
  pendingActivation Boolean   @default(false)
  /// Package terms the customer accepted when applying. null on rows created at
  /// the counter, where the terms are agreed in person.
  termsAcceptedAt   DateTime?
  termsVersion      String?
  customer          Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId, packageSku])
  @@index([expiresAt])
}

model ServiceAddon {
  id            String         @id @default(cuid())
  name          String
  nameTh        String
  price         Int
  isActive      Boolean        @default(true)
  /// Last Bangkok day ("YYYY-MM-DD", inclusive) this add-on is offered, by
  /// APPOINTMENT date. null = no end date. Past it the add-on drops out of every
  /// picker without anyone switching it off.
  availableUntil String?
  /// Fixed commission (ค่ามือ) in satang the stylist earns each time this add-on
  /// is included on a completed booking. 0 = no commission.
  commissionSatang Int         @default(0)
  bookingAddons BookingAddon[]
}

model BookingStaff {
  id        String  @id @default(cuid())
  bookingId String
  staffId   String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([bookingId, staffId])
  @@index([bookingId])
}

model Booking {
  id                String         @id @default(cuid())
  branchId          String
  serviceId         String
  staffId           String?
  customerId        String
  date              DateTime
  startTime         String
  endTime           String
  status            BookingStatus  @default(PENDING)
  /// Customer-visible note. On creation this is copied to internalNotes once;
  /// subsequent customer and staff edits are intentionally independent.
  notes             String?
  /// Staff/admin-only note. Never expose this field through customer APIs.
  internalNotes     String?
  totalPrice        Int
  /// Commission (ค่าตอบแทน/ค่ามือ) for this specific booking, in satang.
  /// New bookings snapshot the current service + add-on commission here;
  /// admins may override it. null keeps legacy bookings on the old live lookup.
  commissionSatang  Int?
  /// Customer tip for this booking, in satang — separate from the commission
  /// above. Goes to the primary stylist's payroll tip on the day it completes.
  tipSatang         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  completedAt       DateTime?
  /// Set when staff tap their name on the front-desk board (/desk) as the
  /// customer arrives. null = not arrived yet. Distinguishes "checked-in / in
  /// service" from a plain CONFIRMED booking without touching BookingStatus.
  checkedInAt       DateTime?
  /// Payment received. Set only by admin flows (POS checkout, slip confirm,
  /// receipt upload, explicit mark-paid) — the desk board's "finished" flips
  /// status to COMPLETED but never touches this: COMPLETED ≠ paid.
  paidAt            DateTime?
  receiptUploadedAt DateTime?
  receiptUrl        String?
  /// Legacy audit flag for bookings that activated a pending membership under
  /// the former auto-activation flow. New bookings leave this false because a
  /// booking alone is not proof of payment.
  activatesMembership Boolean      @default(false)
  /// When the customer ticked the late-arrival terms at the last step of the
  /// booking form, and which wording they saw. null on admin/POS/walk-in
  /// bookings — staff take the booking, so there is no customer to ask.
  termsAcceptedAt   DateTime?
  termsVersion      String?
  branch            Branch         @relation(fields: [branchId], references: [id])
  customer          Customer       @relation(fields: [customerId], references: [id])
  service           Service        @relation(fields: [serviceId], references: [id])
  staff             Staff?         @relation(fields: [staffId], references: [id])
  addons            BookingAddon[]
  extraStaff        BookingStaff[]
  /// Normally one, but a void-and-reissue correction leaves the superseded
  /// row in place (voided, not deleted) alongside its replacement.
  receipts          Receipt[]
  cheers            BookingCheer[]
  couponRedemptions CouponRedemption[]

  @@index([branchId, date])
  @@index([customerId])
  @@index([staffId, date])
  @@index([status, date])
}

model BookingAddon {
  id        String       @id @default(cuid())
  bookingId String
  addonId   String
  price     Int
  addon     ServiceAddon @relation(fields: [addonId], references: [id])
  booking   Booking      @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model AdminUser {
  id            String              @id @default(cuid())
  username      String              @unique
  password      String
  name          String
  role          AdminRole           @default(ADMIN)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sessions      AdminSession[]
  notifications AdminNotification[]
  pushSubs      PushSubscription[]
}

/// In-app notification feed for the owner/admin dashboard — the web-app
/// replacement for owner LINE DMs (new booking, cancellation, nightly summary,
/// payroll). One row per (event × recipient admin); readAt = null means unread.
model AdminNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  /// Deep link opened when the notification is tapped (e.g. /admin/m/<id>).
  href      String?
  branchId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Web Push subscription for an admin device (installed PWA). One row per
/// browser/device; endpoint is unique. Dead subscriptions (404/410 on send) are
/// pruned by the push sender.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model NotificationLog {
  id        String             @id @default(cuid())
  kind      NotificationKind
  targetId  String
  channel   String             @default("line")
  status    NotificationStatus
  recipient String?
  error     String?
  payload   String?
  sentAt    DateTime           @default(now())

  @@unique([kind, targetId])
  @@index([sentAt])
  @@index([status])
}

/// *
///  * Admin expense tracking — costs the salon incurs (supplies, rent, marketing,
///  * utilities, equipment, etc.). Two entry paths:
///  *   1. Manual form
///  *   2. Upload an invoice photo → Claude vision extracts → admin reviews
///  *
///  * branchId is OPTIONAL — null means a shared / HQ expense (e.g. accounting,
///  * marketing campaign across all branches). Per-branch expenses use the id.
///  *
///  * Amounts are stored in satang (THB * 100), matching the Booking convention.
model Expense {
  id            String        @id @default(cuid())
  branchId      String?
  category      String
  /// Legacy free-text vendor name. Kept for the one pre-existing expense (and
  /// as a display fallback) — new writes set this AND vendorId together, so
  /// list views never need the Vendor join just to show a name.
  vendor        String?
  vendorId      String?
  date          DateTime
  totalAmount   Int
  sourceKey     String? @unique
  payeeSnapshot Json?
  invoiceNumber String?
  documentDate  DateTime?
  paidAt        DateTime?
  discountAmount Int @default(0)
  withholdingAmount Int @default(0)
  vatMode       String @default("LEGACY")
  vatRate       Float @default(7)
  vatAmount     Int?
  paymentMethod String?
  /// Legacy single-receipt field, superseded by `attachments` (supports many
  /// files). Kept only so any pre-existing row with a receipt still renders.
  receiptUrl    String?
  notes         String?
  status        String        @default("CONFIRMED")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  branch        Branch?              @relation(fields: [branchId], references: [id])
  vendorRef     Vendor?              @relation(fields: [vendorId], references: [id])
  items         ExpenseItem[]
  attachments   ExpenseAttachment[]

  @@index([branchId, date])
  @@index([category, date])
  @@index([date])
  @@index([vendorId])
}

/// *
///  * A reusable supplier/vendor/payee record, so recurring expenses (rent,
///  * shampoo supplier, freelance stylist) can be searched and reused instead
///  * of retyping a name each time. Expense.vendor (free text) is still set
///  * alongside vendorId on every write, so list views never need this table
///  * joined just to show a name — it exists purely for search/reuse and to
///  * hold contact details.
model Vendor {
  id        String    @id @default(cuid())
  type      String    @default("BUSINESS")
  legalName String?
  taxId     String?
  address   String?
  taxBranch String?
  bankName  String?
  bankAccount String?
  bankAccountName String?
  staffId   String? @unique
  staff     Staff? @relation(fields: [staffId], references: [id], onDelete: Restrict)
  name      String
  phone     String?
  category  String?   // default expense category, speeds re-entry next time
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "Vendor_name_trgm_idx", type: Gin)
}

/// *
///  * One uploaded file (receipt photo, invoice PDF, etc.) attached to an
///  * expense. An expense can have several — e.g. the receipt photo plus a
///  * bank transfer slip.
model ExpenseAttachment {
  id        String   @id @default(cuid())
  expenseId String
  url       String
  filename  String?
  fileType  String?  // MIME type, so the UI can pick an image vs. file icon
  createdAt DateTime @default(now())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

/// *
///  * Line items on an expense (one row per product/service on the invoice).
///  * Useful when an invoice has multiple SKUs (e.g. 3 boxes of shampoo +
///  * 2 boxes of dye on the same receipt).
model ExpenseItem {
  id          String  @id @default(cuid())
  expenseId   String
  kind        String?
  description String
  quantity    Float   @default(1)
  unitPrice   Int
  totalPrice  Int
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

/// *
///  * Payment slips captured from the branch LINE groups.
///  * Staff post bank-transfer slips into the branch group chat; the webhook
///  * downloads the image to Vercel Blob, OCRs the amount/time with Claude
///  * vision, suggests a matching booking (same branch + day + exact amount),
///  * and the admin confirms checkout from /admin/slips with one tap.
///  * bookingId is a plain string (no FK) so deleting a booking never strands
///  * or cascades into slip history.
model PaymentSlip {
  id            String    @id @default(cuid())
  branchId      String
  /// LINE message id of the image — unique so webhook redeliveries dedupe.
  lineMessageId String    @unique
  groupId       String
  imageUrl      String
  /// OCR results — null until parsed or when unreadable. amount is satang.
  amount        Int?
  transferAt    String?
  bankName      String?
  senderName    String?
  ocrStatus     String    @default("PENDING") // PENDING | OK | FAILED
  /// Suggested (auto-match) or admin-chosen booking id.
  bookingId     String?
  status        String    @default("PENDING") // PENDING | CONFIRMED | DISMISSED
  confirmedBy   String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([branchId, status])
}

model ChatMessage {
  id         String   @id
  lineUserId String
  role       String
  content    String
  toolsUsed  String?
  createdAt  DateTime @default(now())

  @@index([lineUserId, createdAt])
}

/// *
///  * Singleton row holding the selling company's legal identity, printed on
///  * every receipt. Editable under admin settings so a tax-ID/address change
///  * never needs a redeploy. Always id = "company".
model CompanyProfile {
  id              String   @id @default("company")
  /// Registered legal name, e.g. "บริษัท เอิร์ก เดย์ จำกัด".
  legalName       String   @default("")
  legalNameEn     String?
  /// 13-digit Revenue Department tax ID (เลขประจำตัวผู้เสียภาษีอากร).
  taxId           String   @default("")
  /// Head-office address as printed (free text, newlines allowed).
  addressLine     String   @default("")
  phone           String?
  /// Off until VAT registration completes. Drives whether receipts show a VAT
  /// breakdown at all — legally you may not print VAT lines before you are
  /// registered, so this gates the whole tax-invoice presentation.
  vatRegistered   Boolean  @default(false)
  vatRatePercent  Int      @default(7)
  receiptFooterTh String?
  logoUrl         String?
  /// Company stamp image (ตราประทับ) for documents such as the 50 ทวิ form.
  stampUrl        String?
  updatedAt       DateTime @updatedAt
}

/// *
///  * Global running-number source for receipts. One row (id = "global");
///  * `lastNumber` is bumped with an atomic UPDATE ... RETURNING inside the
///  * same transaction that creates the Receipt, so a rolled-back sale gives
///  * its number back and the sequence stays gap-free.
model ReceiptCounter {
  id         String @id @default("global")
  lastNumber Int    @default(0)
}

/// *
///  * An issued sales receipt (ใบเสร็จรับเงิน — also serving as ใบกำกับภาษีอย่างย่อ
///  * once the company is VAT-registered). One per paid Booking.
///  *
///  * Everything the document prints is SNAPSHOT here at issue time — seller
///  * identity, VAT rate, and the split amounts. Editing CompanyProfile later
///  * must never rewrite a document that has already been handed to a customer.
///  *
///  * Money is satang like everywhere else. Prices in this app are VAT-INCLUSIVE,
///  * so `grossSatang` is what the customer paid and net/vat are backed out of
///  * it (netSatang + vatSatang === grossSatang, exactly).
model Receipt {
  id               String        @id @default(cuid())
  /// Printed document number, e.g. "2569-000123". Continuous, never reused.
  number           String        @unique
  /// Raw running number behind `number`, for ordering and audit.
  sequence         Int
  /// One ACTIVE receipt per booking — enforced by a partial unique index
  /// (bookingId WHERE voidedAt IS NULL, see migration SQL), not by @unique
  /// here, so a stale receipt can be voided and immediately replaced by a
  /// corrected one on the same booking without a constraint clash. Still the
  /// idempotency key in the common case (a payment path firing twice).
  bookingId        String
  branchId         String
  customerId       String?
  issuedAt         DateTime      @default(now())
  /// AdminUser.id of whoever rang the sale. No FK — admins may be deleted.
  issuedByAdminId  String?
  issuedByName     String?
  /// ── Seller snapshot (from CompanyProfile + Branch at issue time) ──
  sellerName       String
  sellerTaxId      String
  sellerAddress    String
  sellerBranchCode String?
  sellerPhone      String?
  /// ── Buyer: unused today; lets a full ใบกำกับภาษีเต็มรูป be added later ──
  buyerName        String?
  buyerTaxId       String?
  buyerAddress     String?
  /// ── Money snapshot (satang) ──
  grossSatang      Int
  netSatang        Int
  vatSatang        Int
  vatRatePercent   Int
  vatRegistered    Boolean
  /// "RECEIPT" (plain ใบเสร็จรับเงิน) | "ABB_TAX_INVOICE" (ใบกำกับภาษีอย่างย่อ).
  docType          String        @default("RECEIPT")
  paymentMethod    String?
  /// Unguessable id for the public /receipt/<token> URL — never the sequence.
  publicToken      String        @unique
  /// A tax document is voided, never deleted: the number stays burnt.
  voidedAt         DateTime?
  voidReason       String?
  voidedBy         String?
  createdAt        DateTime      @default(now())
  branch           Branch        @relation(fields: [branchId], references: [id])
  booking          Booking       @relation(fields: [bookingId], references: [id])
  items            ReceiptItem[]

  @@index([bookingId])
  @@index([branchId, issuedAt])
  @@index([issuedAt])
  @@index([sequence])
}

model ReceiptItem {
  id              String  @id @default(cuid())
  receiptId       String
  description     String
  quantity        Float   @default(1)
  unitPriceSatang Int
  totalSatang     Int
  sortOrder       Int     @default(0)
  receipt         Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AdminRole {
  OWNER
  ADMIN
}

enum NotificationKind {
  BOOKING_REMINDER_4H
  MEMBERSHIP_ACTIVATED
  MEMBERSHIP_EXPIRY_1D
  PACKAGE_ACTIVATED
  PACKAGE_EXPIRY_1D
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_TERMS_REMINDER
  COUPON_RECEIVED
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

enum StaffPayType {
  MONTHLY_SALARY
  DAILY_WAGE
}

enum PayCadence {
  MONTHLY
  WEEKLY
}

enum PayoutStatus {
  PENDING
  PAID
}

/// *
///  * A staff member customers can vote for in a staff-vote event (first use:
///  * Halloween Staff Challenge 2026). `eventKey` ties the row to one event so
///  * the next campaign reuses these tables. name/photo are display copies, so
///  * the event keeps working if a Staff row is renamed or deactivated.
model VoteCandidate {
  id        String      @id @default(cuid())
  eventKey  String
  name      String
  staffId   String?
  photoUrl  String?
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  votes     StaffVote[]

  @@index([eventKey, sortOrder])
}

/// *
///  * One LINE account's vote. The unique (eventKey, lineUserId, voteDay) is the
///  * "one vote per person per day" guarantee — enforced by the database, not
///  * just the API. Anyone signed in with LINE can vote, shop customer or not:
///  * `customerId` is set only when the account is linked to a customer.
///  * Rows are never edited or deleted: the table is the voting record.
model StaffVote {
  id          String        @id @default(cuid())
  eventKey    String
  candidateId String
  customerId  String?
  /// Bangkok calendar day of the vote ("YYYY-MM-DD").
  voteDay     String
  lineUserId  String?
  /// LINE display name at vote time — shown in the admin log for voters with no customer record.
  voterName   String?
  createdAt   DateTime      @default(now())
  candidate   VoteCandidate @relation(fields: [candidateId], references: [id])
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([eventKey, lineUserId, voteDay])
  @@index([eventKey, candidateId])
}

/// *
///  * Monthly pay slip for one PERSON. A person can own several Staff rows (one
///  * per branch, e.g. วัน / เอิร์น), so the slip keys on `personKey` (the phone's
///  * digits, or the staff id when there is no phone) and lists every row it
///  * covers in `staffIds`. Built as a DRAFT from payroll data, edited by the
///  * owner, then ISSUED — only issued slips are visible to the employee, and an
///  * issued slip is a frozen snapshot (lines + totals) that later payroll edits
///  * never change. Reopening returns it to DRAFT and bumps `revision`.
model Payslip {
  id              String    @id @default(cuid())
  personKey       String
  staffIds        String[]
  /// "YYYY-MM" (Bangkok calendar month).
  month           String
  /// Snapshots printed on the slip.
  name            String
  legalName       String?
  taxId           String?
  /// DRAFT | ISSUED
  status          String    @default("DRAFT")
  /// [{ kind, label, amountSatang }] — kind "DEDUCTION" subtracts, all others add.
  lines           Json
  grossSatang     Int
  deductionSatang Int
  netSatang       Int
  /// Part of the gross already paid out day by day (confirmed daily payroll).
  paidDailySatang Int       @default(0)
  notes           String?
  revision        Int       @default(0)
  issuedAt        DateTime?
  issuedBy        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([personKey, month])
  @@index([month])
}

/// *
///  * ค่าเชียร์: the staff member who sold the customer on a service (treatment)
///  * at POS checkout earns that service's cheerSatang (× quantity). The amount
///  * is snapshotted here, so later rate changes never rewrite past pay. Counted
///  * in that staff member's daily payroll on the booking's day.
model BookingCheer {
  id           String   @id @default(cuid())
  bookingId    String
  staffId      String
  serviceId    String
  quantity     Int      @default(1)
  amountSatang Int
  createdAt    DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([staffId])
}

/// A coupon campaign — one per event or promotion (e.g. Halloween 10%).
/// Customers hold a `Coupon` issued from it; the discount itself is applied at
/// POS checkout, where the server re-checks validity and recomputes the amount.
model CouponCampaign {
  id                String   @id @default(cuid())
  /// Code customers type (LINE hub or at the counter) to get the coupon. Upper-case.
  code              String   @unique
  name              String
  description       String?
  /// Terms & conditions shown to the customer (and the cashier) — free text, one condition per line.
  terms             String?
  /// "PERCENT" (discountValue = 1–100) or "AMOUNT" (discountValue = satang).
  discountType      String   @default("PERCENT")
  discountValue     Int
  /// Cap on a PERCENT discount, satang. Null = no cap.
  maxDiscountSatang Int?
  /// Eligible spend (see `categories`) must reach this, satang.
  minSpendSatang    Int      @default(0)
  /// Service categories the discount covers. Empty = every service except
  /// membership / package purchases.
  categories        String[] @default([])
  /// Bangkok calendar days, stored at UTC noon. Both ends inclusive.
  validFrom         DateTime
  validUntil        DateTime
  /// "OPEN" (anyone can tap รับคูปอง in LINE), "CODE" (must type the code),
  /// "ISSUED" (only admin hands it out).
  claimMode         String   @default("CODE")
  usesPerCoupon     Int      @default(1)
  /// Most coupons this campaign may hand out in total. Null = unlimited.
  maxClaims         Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  coupons           Coupon[]
}

/// One customer's coupon from a campaign — at most one per campaign.
model Coupon {
  id          String    @id @default(cuid())
  campaignId  String
  customerId  String
  /// How they got it: "CLAIM" (LINE button), "CODE" (typed code), "ADMIN", "BULK".
  source      String
  usesAllowed Int       @default(1)
  usesUsed    Int       @default(0)
  voidedAt    DateTime?
  issuedById  String?
  createdAt   DateTime  @default(now())
  campaign    CouponCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@unique([campaignId, customerId])
  @@index([customerId])
}

/// A coupon used on a sale. Reversing (refund / mistake) keeps the row and
/// gives the use back. `source` "APP" = torn in the customer's app at the
/// counter; its bookingId/discount stay empty until the cashier applies the
/// coupon to the bill at POS (which fills them in).
model CouponRedemption {
  id             String    @id @default(cuid())
  couponId       String
  source         String    @default("POS")
  bookingId      String?
  discountSatang Int
  adminId        String?
  createdAt      DateTime  @default(now())
  reversedAt     DateTime?
  coupon         Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  booking        Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([bookingId])
}

/// 50 ทวิ withholding-tax certificates we issue, numbered เล่มที่ (bookNo) /
/// เลขที่ (runNo). The (bookNo, runNo) pair is unique and never reused — a
/// re-print of the same payment keeps its number (one row per expense).
model WithholdingCertificate {
  id            String   @id @default(cuid())
  bookNo        Int
  runNo         Int
  expenseId     String?  @unique
  vendorId      String?
  payeeName     String
  payeeTaxId    String
  /// Payment date the certificate states (UTC noon of the Bangkok day); null = not paid yet / left blank.
  paidDate      DateTime?
  /// Amount subject to withholding (before VAT) and tax withheld, satang.
  incomeSatang  Int
  taxSatang     Int
  formType      String   @default("PND53")
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([bookNo, runNo])
  @@index([vendorId])
}

/// AI reply inbox: one thread per customer per chat channel (LINE now; Facebook /
/// Instagram later). Messages are stored as they arrive; an AI draft is prepared
/// for the owner to review — nothing is sent without a person pressing Send.
model InboxThread {
  id             String         @id @default(cuid())
  /// LINE | FACEBOOK | INSTAGRAM
  channel        String
  externalUserId String
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  displayName    String?
  pictureUrl     String?
  lastMessageAt  DateTime       @default(now())
  lastInboundAt  DateTime?
  /// Inbound messages since the last reply / mark-as-read.
  unread         Int            @default(0)
  /// Latest LINE reply token (free reply while still fresh, ~1 min).
  replyToken     String?
  replyTokenAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  messages       InboxMessage[]
  drafts         InboxDraft[]

  @@unique([channel, externalUserId])
  @@index([lastMessageAt])
}

model InboxMessage {
  id         String      @id @default(cuid())
  threadId   String
  thread     InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// IN (customer) | OUT (us)
  direction  String
  /// text | image | sticker | other
  kind       String      @default("text")
  text       String?
  /// Channel message id — dedupes webhook retries.
  externalId String?     @unique
  /// Our copy of a photo the customer sent (LINE keeps content only for a while).
  mediaUrl   String?
  /// Admin username who sent an OUT message.
  sentBy     String?
  draftId    String?
  createdAt  DateTime    @default(now())

  @@index([threadId, createdAt])
}

model InboxDraft {
  id           String      @id @default(cuid())
  threadId     String
  thread       InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// The latest inbound message this draft answers.
  forMessageId String?
  /// PENDING | READY | FAILED | USED | EDITED | DISCARDED | STALE
  status       String      @default("PENDING")
  /// Reply split into chat bubbles: string[]
  bubbles      Json?
  /// Private note to the owner (never sent): what was checked / what is unsure.
  note         String?
  /// Booking action the AI prepared from the chat — { type: "create" | "cancel", ... };
  /// the owner applies it with one tap ("จอง + ส่ง" / "ยกเลิก + ส่ง").
  booking      Json?
  /// Set once the owner applied it: the booking created or cancelled.
  bookingId    String?
  /// Menu poster keys to send with the reply (see src/lib/inbox-media.ts).
  images       Json?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  error        String?
  /// What the AI saw and did, so the draft can be replayed for evals:
  /// { promptVersion, factsVersion, userText, photoMessageIds, instruction, tools: [{ name, input, result }] }.
  trace        Json?
  /// Hash of the instructions (STYLE) used — text kept once in InboxPromptText.
  promptVersion String?
  /// Owner's reasons for editing / not using the draft (reason chips in the reply box).
  feedback     String[]
  feedbackNote String?
  feedbackAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([threadId, createdAt])
}

/// ── Inventory ────────────────────────────────────────────────────────────────
/// Stock lives at a "location": the owner's home (central warehouse, id "HOME")
/// or a branch (the Branch id). Quantities are whole units (bottles, tubes…).
/// StockMovement is the ledger — every change, signed, with who and why;
/// StockLevel is its running total per product × location (kept in step inside
/// the same transaction) plus that location's low-stock minimum.
model Product {
  id         String   @id @default(cuid())
  name       String
  brand      String?
  /// Size printed on the item, e.g. "200 ml" (display only).
  size       String?
  /// Unit stock is counted in (ขวด, หลอด, ชิ้น…).
  unit       String   @default("ชิ้น")
  /// Suppliers sell by pack: 1 packUnit = packSize units (e.g. 1 กล่อง = 12 ขวด).
  packUnit   String?
  packSize   Int      @default(1)
  /// Latest cost per unit (satang), for stock value and usage cost.
  costSatang Int?
  /// Group for lists and counts (แชมพู / ครีมนวด, สีย้อมผม, …); free text, presets in stock-categories.ts.
  category   String?
  /// USE = shop supplies, SALE = sold to customers, BOTH.
  usage      String   @default("USE")
  /// The retail item (Service in หมวด สินค้า) sold at POS — sales deduct this product.
  serviceId  String?  @unique
  /// Default low-stock minimum for a branch when its level has none set.
  minQty     Int      @default(0)
  imageUrl   String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  levels     StockLevel[]
  movements  StockMovement[]

  @@index([isActive, name])
  @@index([category])
}

model StockLevel {
  id        String   @id @default(cuid())
  productId String
  location  String
  qty       Int      @default(0)
  /// Low-stock minimum here; null → Product.minQty (branches) / 0 (home).
  minQty    Int?
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, location])
  @@index([location])
}

model StockMovement {
  id         String   @id @default(cuid())
  productId  String
  location   String
  /// Signed change in units (+ in, − out).
  qty        Int
  /// OPENING | COUNT | RECEIVE | TRANSFER_OUT | TRANSFER_IN | USE | SALE | SALE_VOID | DAMAGE | ADJUST
  type       String
  /// Level after this movement (for history display).
  balance    Int
  note       String?
  actorName  String
  staffId    String?
  adminId    String?
  expenseId  String?
  receiptId  String?
  transferId String?
  countId    String?
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([location, createdAt])
  @@index([type, createdAt])
  @@index([receiptId])
  @@index([expenseId])
}

/// Delivery from one location to another (home → สุขุมวิท / บางนา). Stock leaves
/// the sender when SENT and arrives when the branch confirms RECEIVED.
model StockTransfer {
  id           String   @id @default(cuid())
  fromLocation String
  toLocation   String
  /// SENT | RECEIVED | CANCELLED
  status       String   @default("SENT")
  note         String?
  sentBy       String
  sentAt       DateTime @default(now())
  receivedBy   String?
  receivedAt   DateTime?
  items        StockTransferItem[]

  @@index([toLocation, status])
  @@index([sentAt])
}

model StockTransferItem {
  id          String        @id @default(cuid())
  transferId  String
  productId   String
  qtySent     Int
  qtyReceived Int?
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

/// A shelf count at one location. The first one is the opening stock; later
/// ones record the difference between the app's number and the shelf.
model StockCount {
  id         String   @id @default(cuid())
  location   String
  countedBy  String
  note       String?
  createdAt  DateTime @default(now())
  lines      StockCountLine[]

  @@index([location, createdAt])
}

model StockCountLine {
  id        String     @id @default(cuid())
  countId   String
  productId String
  expected  Int
  counted   Int
  count     StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@index([countId])
  @@index([productId])
}


/// ── Hair-color record (Oct 2026) ─────────────────────────────────────────────
/// Page 1 of the paper "HAIR COLOR RECORD": one per customer, asked at the salon
/// the first time (never a customer self-service form) and updated when things
/// change. Allergy answers are health data → saved only with consentAt (PDPA).
model HairProfile {
  id                  String    @id @default(cuid())
  customerId          String    @unique
  naturalLevel        Int?
  grayPercent         Int?
  length              String?
  texture             String?
  curl                String?
  density             String?
  condition           String[]
  scalp               String[]
  chemicalHistory     String[]
  lastChemical        String?
  lastChemicalProduct String?
  /// NONE | YES | UNSURE | UNKNOWN
  allergy             String    @default("UNKNOWN")
  allergyDetail       String?
  /// PASS | FAIL — patch test is done only when the stylist has a concern.
  patchTestResult     String?
  patchTestAt         DateTime?
  patchTestBy         String?
  preferredTones      String?
  avoidTones          String?
  goals               String?
  /// Customer tapped consent on the salon's device (health data + in-salon photos).
  consentAt           DateTime?
  consentMarketing    Boolean   @default(false)
  consentVersion      String?
  assessedBy          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

/// Page 2: one per colour job. `zones` holds the mixed formula:
/// [{ zone: ROOT|MID|ENDS|TONER|OTHER, shades: [{ productId, label, grams }],
///    developerPercent, ratio, developerGrams, minutes, startedAt, rinsedAt }].
/// costSatang is computed from grams × stock cost and is ADMIN-ONLY — never
/// send it to staff screens.
model ColorVisit {
  id              String    @id @default(cuid())
  customerId      String
  bookingId       String?   @unique
  branchId        String
  staffId         String?
  stylistName     String
  visitNo         Int
  date            DateTime
  serviceTypes    String[]
  rootLevel       Int?
  midEndsLevel    Int?
  targetLevel     Int?
  grayPercent     Int?
  preChecks       String[]
  patchTestNeeded Boolean   @default(false)
  zones           Json      @default("[]")
  otherProducts   String?
  colorGrams      Int       @default(0)
  developerGrams  Int       @default(0)
  costSatang      Int?
  result          String?
  scalpAfter      String?
  referencePhotos String[]
  beforePhotos    String[]
  afterPhotos     String[]
  nextTimeNotes   String?
  /// DRAFT | DONE
  status          String    @default("DRAFT")
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, date])
  @@index([branchId, date])
}

/// Whether staff can see a week's shift roster in the staff app ("ของฉัน" and
/// "ตารางทีม"). Keyed by the week's Monday (YYYY-MM-DD, Bangkok). No row =
/// visible. Online booking and the admin views always use the shifts.
model ShiftWeekVisibility {
  weekStart String   @id
  hidden    Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
}


/// Each distinct version of the AI inbox instructions ("STYLE") and shop facts,
/// stored once by hash; InboxDraft.trace points at them (eval replays).
model InboxPromptText {
  hash      String   @id
  kind      String
  text      String
  createdAt DateTime @default(now())
}
